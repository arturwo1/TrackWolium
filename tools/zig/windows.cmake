set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(_zig_dir "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(CMAKE_C_COMPILER "${_zig_dir}/zig-cc")
set(CMAKE_CXX_COMPILER "${_zig_dir}/zig-c++")
set(CMAKE_AR "${_zig_dir}/zig-ar")
set(CMAKE_RANLIB "${_zig_dir}/zig-ranlib")
set(CMAKE_RC_COMPILER "${_zig_dir}/zig-rc")
set(CMAKE_RC_OUTPUT_EXTENSION .res)
set(CMAKE_RC_COMPILE_OBJECT "<CMAKE_RC_COMPILER> /fo <OBJECT> <DEFINES> <INCLUDES> <FLAGS> <SOURCE>")
set(CMAKE_RC_FLAGS_INIT "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
